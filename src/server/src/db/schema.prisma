datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Player {
  // PostgreSQL uses uuid() or autoincrement() instead of ObjectId
  id        String   @id @default(uuid()) 
  username  String   @unique
  score     Int      @default(0)     // Added this so your scores sync!
  isOnline  Boolean  @default(false)
  x         Float    @default(100)
  y         Float    @default(100)
  createdAt DateTime @default(now())
}